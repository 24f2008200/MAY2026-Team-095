# Application security (replace for every real deployment)
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value

# Environment-managed demo administrator
ADMIN_EMAIL=admin@society.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Administrator

# Realistic starter records
SEED_DEMO_DATA=true
RECOVERY_TEST_EMAIL=resident@example.com

# Recommended on Render Free: HTTPS email delivery through Brevo
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Smart Society

# Optional SMTP fallback for hosts that permit outbound SMTP
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
