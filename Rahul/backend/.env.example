SECRET_KEY=change-this-secret-key
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
JWT_SECRET_KEY=change-this-jwt-secret

# --- SMTP: used for the forgot-password email (feature) ---
# Zoho Mail SMTP. Use a Zoho "app-specific password" for MAIL_PASSWORD,
# not your normal Zoho login password (Zoho Mail Settings -> Security ->
# App Passwords) - required if 2FA is on, and recommended either way.
MAIL_SERVER=smtp.zoho.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-zoho-email@yourdomain.com
MAIL_PASSWORD=your-zoho-app-specific-password
MAIL_DEFAULT_SENDER=your-zoho-email@yourdomain.com
